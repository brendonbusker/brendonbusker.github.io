---
import BaseLayout from '../../layouts/BaseLayout.astro';
import resumeData from '../../data/resume.json';
import { resumeSchema } from '@brendon/shared';
const resume = resumeSchema.parse(resumeData);
---
<BaseLayout current="resume" title="Résumé — Brendon Busker" description="Experience, skills, education, and selected work from Brendon Busker.">
  <header class="page-intro resume-heading"><p class="eyebrow">Résumé</p><h1>{resume.fullName}</h1><div><p>{resume.headline}</p><a class="download-link" href={resume.pdfPath} download>Download PDF <span aria-hidden="true">↓</span></a></div></header>
  <div class="resume-layout"><aside><p class="resume-summary">{resume.summary}</p><section><h2>Contact</h2><ul class="resume-links">{resume.links.filter(l=>l.public).map(link=><li><span>{link.label}</span><a href={link.url||undefined}>{link.value}</a></li>)}</ul></section><section><h2>Skills</h2>{resume.skillGroups.map(group=><div class="skill-group"><h3>{group.name}</h3><p>{group.skills.join(' · ')}</p></div>)}</section></aside><div class="resume-main"><section><h2>Experience</h2><div class="timeline">{resume.experience.map(item=><article><div class="timeline-marker"></div><header><div><h3>{item.role}</h3><p>{item.employer}</p></div><div><p>{item.startDate} — {item.current?'Present':item.endDate}</p><p>{item.location}</p></div></header>{item.description&&<p class="role-description">{item.description}</p>}<ul>{item.accomplishments.map(a=><li>{a}</li>)}</ul></article>)}</div></section><section><h2>Education</h2>{resume.education.map(item=><article class="education"><div><h3>{item.school}</h3><p>{item.degree}{item.field?`, ${item.field}`:''}</p></div><div><p>{item.startDate} — {item.endDate}</p><p>{item.location}</p></div></article>)}</section><section><h2>Certifications</h2><div class="certifications">{resume.certifications.map(item=><article><h3>{item.name}</h3><p>{item.issuer} · {item.date}</p></article>)}</div></section><section><h2>Selected work</h2>{resume.selectedWork.map(work=><article class="selected-work"><div><h3>{work.name}</h3><p>{work.summary}</p></div>{work.url&&<a href={work.url}>View project <span aria-hidden="true">↗</span></a>}</article>)}</section></div></div>
</BaseLayout>
