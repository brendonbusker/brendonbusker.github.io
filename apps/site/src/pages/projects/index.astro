---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import projectPageData from '../../data/projects-page.json';
import { projectPageSchema } from '@brendon/shared';
const projectPage = projectPageSchema.parse(projectPageData);
const projects = (await getCollection('projects', ({data})=>data.published)).sort((a,b)=>a.data.sortOrder-b.data.sortOrder);
const rendered = await Promise.all(projects.map(async project => ({project,Content:(await render(project)).Content,cover:project.data.screenshots[0]})));
---
<BaseLayout current="projects" title="Projects — Brendon Busker" description="Selected applications and projects built by Brendon Busker.">
  <header class="page-intro projects-intro"><p class="eyebrow">{projectPage.eyebrow}</p><h1>{projectPage.headline}</h1><p>{projectPage.description}</p></header>
  <div class="project-grid">{projects.map((project)=><button class="project-card" data-project={project.data.slug} style={`--project-accent:${project.data.accent}`} aria-haspopup="dialog"><span class="project-icon"><Icon name={project.data.icon} size={32}/></span><span class="project-meta">{project.data.category} · {project.data.status}</span><strong>{project.data.title}</strong><span class="project-summary">{project.data.summary}</span><span class="project-open">Read the story <span aria-hidden="true">↗</span></span></button>)}</div>
  {rendered.map(({project,Content,cover})=><dialog class="project-dialog" data-project-dialog={project.data.slug} aria-labelledby={`project-title-${project.data.slug}`}><div class="dialog-shell"><button class="dialog-close" type="button" aria-label={`Close ${project.data.title}`}><span aria-hidden="true">×</span></button><header class={cover?'has-image':undefined} style={`--project-accent:${project.data.accent}`}>{cover&&<img class="project-hero-image" src={cover.src} alt="" aria-hidden="true" decoding="async"/>}<div class="project-icon large"><Icon name={project.data.icon} size={40}/></div><p>{project.data.category} · {project.data.status}</p><h2 id={`project-title-${project.data.slug}`}>{project.data.title}</h2><p>{project.data.summary}</p></header><div class="project-story"><section><h3>Overview</h3><div class="prose compact"><Content /></div></section>{project.data.why&&<section><h3>Why I built it</h3><p>{project.data.why}</p></section>}{project.data.features.length>0&&<section><h3>Notable features</h3><ul>{project.data.features.map(f=><li>{f}</li>)}</ul></section>}{project.data.implementation&&<section><h3>Implementation</h3><p>{project.data.implementation}</p><p class="technology">{project.data.techStack.join(' · ')}</p></section>}</div><footer>{project.data.liveUrl&&<a class="dark-link" href={project.data.liveUrl} target="_blank" rel="noopener noreferrer">Open live project <span aria-hidden="true">↗</span></a>}{project.data.githubUrl&&<a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>}</footer></div></dialog>)}
  <script>
    const cards=[...document.querySelectorAll<HTMLButtonElement>('[data-project]')]; const dialogs=new Map([...document.querySelectorAll<HTMLDialogElement>('[data-project-dialog]')].map(d=>[d.dataset.projectDialog!,d])); let trigger:HTMLButtonElement|null=null; let openedFromHistory=false;
    const updateUrl=(slug:string|null,replace=false)=>{const url=new URL(location.href);slug?url.searchParams.set('project',slug):url.searchParams.delete('project');history[replace?'replaceState':'pushState']({project:slug},'',url)};
    const open=(slug:string,fromHistory=false)=>{const dialog=dialogs.get(slug);if(!dialog||dialog.open)return;trigger=cards.find(c=>c.dataset.project===slug)||null;openedFromHistory=fromHistory;dialog.showModal();document.body.classList.add('dialog-open');};
    const close=(dialog:HTMLDialogElement,fromHistory=false)=>{if(dialog.open)dialog.close();document.body.classList.remove('dialog-open');if(!fromHistory){if(openedFromHistory)updateUrl(null,true);else history.back();}trigger?.focus();openedFromHistory=false};
    cards.forEach(card=>card.addEventListener('click',()=>{updateUrl(card.dataset.project!);open(card.dataset.project!)})); dialogs.forEach(dialog=>{dialog.querySelector('.dialog-close')?.addEventListener('click',()=>close(dialog));dialog.addEventListener('click',e=>{if(e.target===dialog)close(dialog)});dialog.addEventListener('cancel',e=>{e.preventDefault();close(dialog)})});
    addEventListener('popstate',()=>{const slug=new URL(location.href).searchParams.get('project');dialogs.forEach(d=>{if(d.open&&d.dataset.projectDialog!==slug)close(d,true)});if(slug)open(slug,true)});const initial=new URL(location.href).searchParams.get('project');if(initial)open(initial,true);
  </script>
</BaseLayout>
