---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => data.status === 'published')).sort((a,b)=>+b.data.publishedAt-+a.data.publishedAt);
const latest = posts[0];
const recent = posts.slice(1,5);
const postUrl = (post: typeof posts[number]) => { const d=post.data.publishedAt; return `/notes/${d.getUTCFullYear()}/${String(d.getUTCMonth()+1).padStart(2,'0')}/${String(d.getUTCDate()).padStart(2,'0')}/${post.data.slug}/`; };
const formatDate = (date:Date) => date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
---
<BaseLayout current="home">
  <section class="hero" aria-labelledby="intro-title">
    <p class="eyebrow">{site.location} · {site.timezone}</p>
    <h1 id="intro-title">{site.fullName}</h1>
    <p class="hero-headline">{site.professionalHeadline}</p>
    <div class="hero-copy"><p>{site.intro}</p><p>{site.secondaryIntro}</p></div>
    <nav class="text-links" aria-label="Profile links">
      {site.socialLinks.map((link) => <a href={link.url} rel="me noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>)}
      <a href="/projects/">Browse projects <span aria-hidden="true">→</span></a>
    </nav>
  </section>
  <section class="notes-lead" aria-labelledby="notes-title">
    <div class="section-kicker"><p>Notes</p><a href="/notes/">View all notes <span aria-hidden="true">→</span></a></div>
    {latest && <div class="latest-note">
      <time datetime={latest.data.publishedAt.toISOString()}><a href={postUrl(latest)}>{formatDate(latest.data.publishedAt)}</a></time>
      <h2 id="notes-title"><a href={postUrl(latest)}>{latest.data.title}</a></h2>
      <p>{latest.data.excerpt}</p>
    </div>}
    {recent.length > 0 && <div class="recent-notes">{recent.map(post=><article><time datetime={post.data.publishedAt.toISOString()}><a href={postUrl(post)}>{formatDate(post.data.publishedAt)}</a></time><h3><a href={postUrl(post)}>{post.data.title}</a></h3><p>{post.data.excerpt}</p></article>)}</div>}
  </section>
</BaseLayout>
