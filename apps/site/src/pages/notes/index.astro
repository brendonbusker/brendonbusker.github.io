---
import BlogArchive from '../../components/BlogArchive.astro';
import { blogPageSchema } from '@brendon/shared';

import blogPageData from '../../data/blog-page.json';
const blogPage = blogPageSchema.parse(blogPageData);
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Blog — Brendon Busker" description={blogPage.description} current="blog">
  <header class="page-intro"><p class="eyebrow">{blogPage.eyebrow}</p><h1>{blogPage.headline}</h1><p>{blogPage.description}</p></header>
  <BlogArchive />
</BaseLayout>
