{
  "name": "@brendon/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev --port 8787",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply personal-site-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-site-cms --remote"
  },
  "dependencies": {
    "@brendon/shared": "workspace:*",
    "@fluentui/react-components": "^9.70.0",
    "@fluentui/react-icons": "^2.0.316",
    "@hono/zod-validator": "^0.7.2",
    "@tiptap/extension-image": "^3.4.1",
    "@tiptap/extension-link": "^3.4.1",
    "@tiptap/extension-table": "^3.4.1",
    "@tiptap/extension-table-cell": "^3.4.1",
    "@tiptap/extension-table-header": "^3.4.1",
    "@tiptap/extension-table-row": "^3.4.1",
    "@tiptap/extension-task-item": "^3.4.1",
    "@tiptap/extension-task-list": "^3.4.1",
    "@tiptap/extension-text-align": "^3.4.1",
    "@tiptap/extension-underline": "^3.4.1",
    "@tiptap/pm": "^3.4.1",
    "@tiptap/react": "^3.4.1",
    "@tiptap/starter-kit": "^3.4.1",
    "dompurify": "^3.2.6",
    "hono": "^4.9.6",
    "marked": "^16.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.33.1"
  }
}
